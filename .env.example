# Copy to .env and fill in secrets. Loaded by `make run`.
APP_PORT=8080
APP_HOST=0.0.0.0
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=text
APP_ADMIN_PASSWORD=Toyota410

APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=jokefactory
APP_DB_SSLMODE=disable

# Leave empty to use stub classifier; set both to use Foundry
APP_LLM_BASE_URL=
APP_LLM_API_KEY=
APP_LLM_DEPLOYMENT=gpt-4o-mini
APP_LLM_TEMPERATURE=0
APP_LLM_MAX_RETRIES=3
